# ---------------------------------------------------------------------------
# Üs Koruma Sistemi — ortam değişkenleri (docker-compose ve yerel çalıştırma)
# cp .env.example .env
# ---------------------------------------------------------------------------

# --- Gateway kimlik doğrulama (virgülle ayrılmış anahtarlar). Boş = auth KAPALI (yalnızca geliştirme!)
GATEWAY_API_KEYS=dev-key-change-me
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- LLM (risk-agent-svc). Boşsa kural tabanlı fallback kullanılır (demo yine uçtan uca çalışır)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5
# "" | enabled | disabled  (GLM-4.5+ 'thinking' parametresi; gecikme/maliyet için "disabled" düşünülebilir)
GLM_THINKING=

# --- Bütçe / kota (risk-agent-svc)
BUDGET_DAILY_TOKENS=200000
BUDGET_REQUESTS_PER_HOUR=120
BUDGET_ASSESSMENTS_PER_HOUR=60
BUDGET_TOKENS_PER_ASSESSMENT=30000
# fallback: kural motoruna düş | reject: HTTP 429
ON_BUDGET_EXCEEDED=fallback

# --- Detection
# MOCK_MODE=true: model yokken bbox'lar veri setindeki ground_truth.json'dan gelir (yoksa rastgele). Gerçek Stage 1 modeli için
# detection-svc/models/stage1.pt koyup MOCK_MODE=false ve DETECTION_WITH_MODEL=true verin.
MOCK_MODE=true
DETECTION_WITH_MODEL=false

# --- Olay veri seti (container içi yol; host'taki ./data /data olarak bağlanır)
# Sentetik set: /data/synthetic (scripts/gen_dataset.py üretir). Gerçek veri: dosyaları ./data/ altına koyup DATA_DIR=/data yapın.
DATA_DIR=/data/synthetic
# image_meta.capture_time ve tracks.csv 'HH:MM' tarihsizdir; epoch eşlemesi için sabit gün (tüm servislerde aynı)
DATASET_DATE=2025-06-01

# --- Veritabanı (docker-compose db servisi)
POSTGRES_PASSWORD=change-me

# --- Üs: olay akışında zones.json'dan gelir. Aşağıdakiler eski/demo akışı ve (zones.json'da yoksa) varsayılan yarıçap içindir.
BASE_LAT=39.9000
BASE_LON=32.7500
BASE_RADIUS_M=1500

# --- Eski/demo akış (drone_meta + duvar saatine çapalı sentetik kafile). Varsayılan KAPALI.
DEMO_MODE=false
LOG_LEVEL=INFO
