# ---------------------------------------------------------------------------
# Üs Koruma Sistemi — ortam değişkenleri (docker-compose ve yerel çalıştırma)
# cp .env.example .env
# ---------------------------------------------------------------------------

# --- Gateway kimlik doğrulama (virgülle ayrılmış anahtarlar). Boş = auth KAPALI (yalnızca geliştirme!)
GATEWAY_API_KEYS=dev-key-change-me
# UI ana sayfada anahtar SORMAZ: web-ui'nin nginx'i bu anahtarı /api isteklerine sunucu tarafında ekler (varsayılan GATEWAY_API_KEYS'in ilki).
# Boş verirseniz (UI_GATEWAY_API_KEY=) enjeksiyon kapanır ve UI 401'de anahtar sorar. Doğrudan gateway'e (:8000) erişim anahtar ister.
# UI_GATEWAY_API_KEY=dev-key-change-me
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Dış erişim giriş kapısı (auth-proxy + auth-svc). Host :8080 (UI) ve :8000 (gateway) YALNIZCA giriş sonrası açılır.
# ZORUNLU, varsayılanı YOK (boşsa compose ve auth-svc açılmaz). Gerçek değerleri yalnızca .env'ye yazın (git'e girmez).
#   şifre (en az 12 karakter): python -c 'import secrets; print(secrets.token_urlsafe(18))'
#   çerez imza anahtarı (en az 32 karakter): openssl rand -hex 32
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
# AUTH_SESSION_HOURS=12

# --- LLM sağlayıcı (risk-agent-svc). BİRİNCİL SAĞLAYICI: OpenRouter (demo). GLM (organizatör gateway'i) İKİNCİL: kod yolunda durur, LLM_PROVIDER=glm ile açılır.
# Anahtar yoksa risk ajanı kural tabanlı (LLM'siz) modda çalışır. AKTİF olan LLM_PROVIDER ile seçilir:
#   openrouter → BİRİNCİL. Model nvidia/nemotron-3-ultra-550b-a55b:free (tool_calling doğrulandı). reasoning_effort GÖNDERİLMEZ.
#                Ücretsiz katman: 20 istek/dk, 50 istek/GÜN → günlük tavan 40 (LLM_MAX_REQUESTS_PER_DAY); aşılınca ajan kural motoruna düşer.
#   glm        → İKİNCİL. Organizatörün Z.ai gateway'i (GLM_* değişkenleri; reasoning_effort gönderilir; bütçe key/info ile okunur). Anahtar gelmedi, canlı denenmedi.
# LLM_BASE_URL / LLM_MODEL / LLM_API_KEY (sağlayıcıdan bağımsız) verilirse seçili sağlayıcının değerlerini geçersiz kılar.
LLM_PROVIDER=openrouter

# --- 1) OpenRouter (BİRİNCİL)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Aynısı sağlayıcıdan bağımsız adlarla da verilebilir (OPENROUTER_* değerlerini geçersiz kılar):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_API_KEY=sk-or-...
# LLM_MAX_REQUESTS_PER_DAY=40
# Ajan döngüsü: modeller araçları tek tek çağırırsa tur biter → varsayılan 12 tur + prompt'ta "tüm araçları aynı turda paralel çağır"
# AGENT_MAX_ROUNDS=12

# --- 2) GLM (İKİNCİL; organizatör gateway'i) — LLM_PROVIDER=glm iken kullanılır
# GLM_API_KEY=
# GLM_BASE_URL=https://berriailitellm-databasev1826rc3-production-d691.up.railway.app/v1
# GLM_ROOT_URL=https://berriailitellm-databasev1826rc3-production-d691.up.railway.app
# GLM_MODEL=glm-5.3-flash
# low | high | max ('thinking' parametresi GLM'de HATA verir: GLM_THINKING kaldırıldı)
# GLM_REASONING_EFFORT=low
# GLM_MAX_TOKENS=4000

# --- Bütçe / kota (risk-agent-svc). Organizatör: TOPLAM 15 USD (SIFIRLANMAZ), 60 istek/dk, 500K token/dk, aynı anda 4 istek.
# Harcama GET {kök}/key/info (spend/max_budget) ile okunur; kalan <= rezerv olunca LLM kullanılmaz.
BUDGET_TOTAL_USD=15
BUDGET_RESERVE_USD=1
BUDGET_REQUESTS_PER_MINUTE=50
BUDGET_TOKENS_PER_MINUTE=400000
BUDGET_TOKENS_PER_ASSESSMENT=60000
# fallback: kural motoruna düş (400 "Budget has been exceeded" dahil) | reject: HTTP 429
ON_BUDGET_EXCEEDED=fallback

# --- Detection
# MOCK_MODE=true: model yokken bbox'lar veri setindeki ground_truth.json'dan gelir (yoksa rastgele). Gerçek Stage 1 modeli için
# detection-svc/models/stage1.pt koyup MOCK_MODE=false ve DETECTION_WITH_MODEL=true verin.
MOCK_MODE=true
# Gerçek D-FINE (detection-svc/models/dfine.pt): DETECTION_WITH_MODEL=dfine MOCK_MODE=false MODEL_BACKEND=dfine MODEL_PATH=/srv/models/dfine.pt
# (DETECTION_WITH_MODEL: false | true = ultralytics | dfine). Model yüklenemezse servis açılmaz; MOCK_FALLBACK=true ile mock'a düşer ve /health "degraded" olur.
DETECTION_WITH_MODEL=false
MODEL_BACKEND=ultralytics
MODEL_PATH=/srv/models/stage1.pt
MOCK_FALLBACK=false
# Tespit güven eşiği (varsayılan 0.4; 0.25 daha yüksek recall + daha çok izsiz gürültü kutusu)
CONF_THRESHOLD=0.4

# --- Olay veri seti (container içi yol; host'taki ./data /data olarak bağlanır)
# Sentetik set: /data/synthetic (scripts/gen_dataset.py üretir). Gerçek veri: dosyaları ./data/ altına koyup DATA_DIR=/data yapın.
DATA_DIR=/data/synthetic
# image_meta.capture_time ve tracks.csv 'HH:MM' tarihsizdir; epoch eşlemesi için sabit gün (tüm servislerde aynı)
DATASET_DATE=2025-06-01

# --- Veritabanı (docker-compose db servisi)
POSTGRES_PASSWORD=change-me

# --- Üs: olay akışında zones.json'dan gelir. Aşağıdakiler eski/demo akışı ve (zones.json'da yoksa) varsayılan yarıçap içindir.
BASE_LAT=39.9000
BASE_LON=32.7500
BASE_RADIUS_M=1500

# --- Eski/demo akış (drone_meta + duvar saatine çapalı sentetik kafile). Varsayılan KAPALI.
DEMO_MODE=false
LOG_LEVEL=INFO
