# Tüm değişkenler opsiyoneldir.
# Gateway adresi (varsayılan: aynı origin altında /api — Ingress/nginx/Vite proxy).
VITE_API_BASE=/api
# Dev sunucusunun /api'yi yönlendireceği gateway (yalnızca `npm run dev`)
VITE_DEV_GATEWAY=http://localhost:8000
# Polling aralığı (ms)
VITE_POLL_MS=2000
# Harita katmanı (çevrimdışı ortamda kendi tile sunucunuzu verin)
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GELİŞTİRME KOLAYLIĞI: API anahtarını build'e gömmek güvenli DEĞİLDİR; boş bırakın,
# UI 401 alınca anahtarı sorar ve yalnızca tarayıcının localStorage'ında saklar.
VITE_API_KEY=
